{
  "name": "gherkin-to-playwright-pipeline",
  "version": "1.0.0",
  "private": true,
  "description": "Jira AI Gherkin Generator (Steps 1-3) + Gherkin-to-Playwright test pipeline",
  "main": "pipeline.js",
  "type": "commonjs",
  "scripts": {
    "start": "tsx src/index.ts",
    "pipeline:full": "tsx src/full-pipeline.ts",
    "build": "tsc -p tsconfig.json",
    "test:generated": "playwright test tests/generated",
    "analyze": "tsx src/cli.ts",
    "analyze:failures": "tsx src/agents/failure-analysis.ts",
    "repair:propose": "tsx src/repair-agent/repair-agent.ts",
    "repair:auto": "tsx src/agents/auto-repair.ts",
    "agent:understand": "tsx src/page-analyzer.ts",
    "fetch:jira": "node jira-fetcher.js",
    "convert:adf": "node adf-to-text.js",
    "generate:gherkin": "node gherkin-generator.js",
    "generate:gherkin:mock": "node gherkin-generator.js --mock",
    "generate:gherkin:groq": "node gherkin-generator.js --groq",
    "pipeline": "node pipeline.js",
    "pipeline:mock": "node pipeline.js --mock",
    "pipeline:groq": "node pipeline.js --groq",
    "extract:selectors": "playwright test --config=playwright.extract.config.ts"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "@playwright/test": "^1.55.0",
    "dotenv": "^17.4.2",
    "node-fetch": "^2.7.0",
    "openai": "^7.0.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "tsx": "^4.19.0",
    "typescript": "^5.5.4"
  }
}
